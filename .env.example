# Simple 2D Animation Studio — Sample environment (copy to .env, never commit real secrets)

# Backend API port
PORT=8787

# Directory for server-side encrypted provider credentials & temp export files
STUDIO_DATA_DIR=./backend/data

# Master key for AES-256-GCM encryption of stored API keys (32 bytes hex).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SECRET_KEY=

# Optional: seed a default OpenAI-compatible provider (kept server-side only)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Path to ffmpeg binary if not on PATH
# FFMPEG_PATH=/usr/bin/ffmpeg

# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
